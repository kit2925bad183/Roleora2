# =============================================================================
# ROLEORA - Development Environment Configuration Template
# =============================================================================
# Copy this file to .env or inject through the AI Studio Secrets panel.
# Never commit real API keys or sensitive private credentials to source control.

# Google Cloud / Gemini AI API Key (Server-side injected)
GEMINI_API_KEY=

# Firebase Client Configuration (Development Project)
FIREBASE_PROJECT_ID=roleora-dev
FIREBASE_APPLICATION_ID=
FIREBASE_API_KEY=

# App Check Debug Token (Local emulator / Debug APK testing only)
FIREBASE_APPCHECK_DEBUG_TOKEN=
